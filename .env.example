# Sao chép thành .env (make init làm việc này). Hostname là tên service trong compose.yaml.

# ---------- API ----------
API_PORT=4000
DATABASE_URL=postgresql://travelpad:travelpad@postgres:5432/travelpad?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
# Deploy sau proxy (Render/Vercel): TRUST_PROXY=true – xem docs/deploy.md
S3_ENDPOINT=http://s3:8333
S3_BUCKET=travelpad-media
S3_ACCESS_KEY=travelpad
S3_SECRET_KEY=travelpad-secret
S3_PUBLIC_URL=http://localhost:8333/travelpad-media
SMTP_URL=smtp://mailpit:1025

# ---------- WEB ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trình duyệt gọi API qua cổng publish ra host
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Server Components (trong container web) gọi API qua mạng nội bộ docker
API_INTERNAL_URL=http://api:4000/v1

# ---------- Cổng publish ra host (đổi nếu bị trùng) ----------
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
